# Required
DATABASE_URL=postgres://user:pass@host:5432/dbname
SESSION_SECRET=generate-a-long-random-string

# Seeds the super admin on first boot. Safe to leave set.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_NAME=Your Name

# Public URL of the app. Used to build magic links.
# On Railway set this to the generated domain, e.g. https://phonebank-production.up.railway.app
APP_URL=

# Optional: send magic links by email. Without this the admin copies the link
# from the screen and sends it to the volunteer themselves.
RESEND_API_KEY=
RESEND_FROM=Phone Bank <phonebank@yourdomain.com>

# Optional
EXPORT_TIMEZONE=America/New_York
