# Required
DATABASE_URL=postgres://user:pass@host:5432/dbname
SESSION_SECRET=generate-a-long-random-string

# Seeds the super admin on first boot. Safe to leave set.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_NAME=Your Name

# Public URL of the app. Used to build magic links.
# On Railway set this to the generated domain, e.g. https://phonebank-production.up.railway.app
APP_URL=

# Optional: send magic links by email. With none of these set, the admin copies
# the link off the screen and sends it to the volunteer themselves.
#
# MAIL_FROM is used by every backend below.
MAIL_FROM=Phone Bank <you@yourdomain.com>
#
# Option A, SendGrid. No DNS: verify MAIL_FROM's address under Single Sender
# Verification, then create a Mail Send API key.
SENDGRID_API_KEY=
#
# Option B, Resend. Needs a verified sending domain (DKIM, SPF and MX records).
RESEND_API_KEY=
#
# Option C, SMTP. Only where outbound SMTP is allowed. Most managed hosts,
# Railway included, block ports 465 and 587, so this will time out there.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional
EXPORT_TIMEZONE=America/New_York

# Set to 'off' only when running over plain http (local production builds).
COOKIE_SECURE=
